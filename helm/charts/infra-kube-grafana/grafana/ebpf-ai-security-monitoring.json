{
  "id": null,
  "title": "🛡️ eBPF + AI Security Monitoring",
  "tags": ["ebpf", "security", "ai", "threats"],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "🚨 Total Threats Detected",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ml_detector_threats_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          },
          "unit": "short",
          "displayName": "Total Threats"
        }
      },
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "📊 High Confidence Threats",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ml_detector_threats_total{confidence_level=\"high\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 5},
              {"color": "red", "value": 20}
            ]
          },
          "unit": "short",
          "displayName": "High Confidence"
        }
      },
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "title": "⚡ eBPF Events/sec",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(ebpf_events_processed_total[1m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "displayName": "Events/sec"
        }
      },
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "title": "🌐 Network Traffic (GB/s)",
      "type": "stat",
      "targets": [
        {
          "expr": "ebpf_bytes_per_second / 1000000000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "displayName": "GB/s",
          "decimals": 2
        }
      },
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 5,
      "title": "🔍 Threat Types Distribution",
      "type": "piechart",
      "targets": [
        {
          "expr": "ml_detector_threats_total",
          "refId": "A",
          "legendFormat": "{{threat_type}} ({{confidence_level}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 6,
      "title": "📈 Threat Detection Timeline",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(ml_detector_threats_total[1m])",
          "refId": "A",
          "legendFormat": "{{threat_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 7,
      "title": "🌐 Network Protocol Traffic",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(ebpf_bytes_processed_total[1m]) / 1000000",
          "refId": "A",
          "legendFormat": "{{protocol}} MB/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 8,
      "title": "📊 ML Processing Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(ml_detector_requests_total[1m])",
          "refId": "A",
          "legendFormat": "Requests/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "id": 9,
      "title": "⚠️ Communication Failures",
      "type": "stat",
      "targets": [
        {
          "expr": "ebpf_ml_post_failures_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "short",
          "displayName": "Failures"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24}
    },
    {
      "id": 10,
      "title": "📊 Total Data Processed",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ebpf_bytes_processed_total) / 1000000000000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "displayName": "TB Processed",
          "decimals": 2
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24}
    }
  ]
}