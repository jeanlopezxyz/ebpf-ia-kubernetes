apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: {{ gateway_api.gateway.name }}
  namespace: {{ gateway_api.gateway.namespace }}
  labels:
    app.kubernetes.io/name: {{ gateway_api.gateway.name }}
    app.kubernetes.io/component: gateway
    app.kubernetes.io/managed-by: ansible
    app.kubernetes.io/part-of: ebpf-ai-platform
spec:
  gatewayClassName: {{ gateway_api.gateway.className }}
  
  listeners:
  # HTTP Listener (port 80)
  - name: http
    port: 80
    protocol: HTTP
    allowedRoutes:
      namespaces:
        from: All
        
  # HTTPS Listener (port 443)
  - name: https
    port: 443
    protocol: HTTPS
    allowedRoutes:
      namespaces:
        from: All
    {% if gateway_api.tls.enabled | default(false) %}
    tls:
      mode: Terminate
      # Certificate references will be added when cert-manager is configured
    {% endif %}
---
# Gateway Service for external access (NodePort/LoadBalancer)
apiVersion: v1
kind: Service  
metadata:
  name: {{ gateway_api.gateway.name }}-service
  namespace: {{ gateway_api.gateway.namespace }}
  labels:
    app.kubernetes.io/name: {{ gateway_api.gateway.name }}
    app.kubernetes.io/component: service
    app.kubernetes.io/managed-by: ansible
spec:
  type: {{ gateway_api.service.type }}
  {% if gateway_api.service.type == "NodePort" %}
  ports:
  - name: http
    port: 80
    targetPort: 80
    nodePort: {{ gateway_api.service.node_ports.http }}
    protocol: TCP
  - name: https
    port: 443
    targetPort: 443  
    nodePort: {{ gateway_api.service.node_ports.https }}
    protocol: TCP
  {% else %}
  ports:
  - name: http
    port: 80
    targetPort: 80
    protocol: TCP
  - name: https
    port: 443
    targetPort: 443
    protocol: TCP
  {% endif %}
  selector:
    # Selector will match Gateway pods (implementation dependent)
    io.cilium.app/name: cilium-gateway  # Cilium specific selector