apiVersion: v1
kind: ConfigMap
metadata:
  name: gateway-api-info
  namespace: {{ gateway_api.gateway.namespace }}
  labels:
    app.kubernetes.io/name: {{ gateway_api.gateway.name }}
    app.kubernetes.io/component: info
    app.kubernetes.io/managed-by: ansible
data:
  README.md: |
    # Gateway API Configuration
    
    This Gateway provides modern API routing for the eBPF-AI platform.
    
    ## Gateway Details
    - **Name**: {{ gateway_api.gateway.name }}
    - **Namespace**: {{ gateway_api.gateway.namespace }}
    - **Class**: {{ gateway_api.gateway.className }}
    - **Implementation**: Cilium with eBPF
    
    ## Service Endpoints
    {% if gateway_api.service.type == "NodePort" %}
    ### NodePort Access (via External Load Balancer)
    - **HTTP**: http://{{ kubeadm.static_ip }}:{{ gateway_api.service.node_ports.http }}
    - **HTTPS**: https://{{ kubeadm.static_ip }}:{{ gateway_api.service.node_ports.https }}
    
    ### External Load Balancer (HAProxy)
    - **HTTP**: http://{{ network.load_balancer.vip | default("10.0.10.99") }}:80
    - **HTTPS**: https://{{ network.load_balancer.vip | default("10.0.10.99") }}:443
    {% endif %}
    
    ## How Services Use This Gateway
    
    Services can reference this Gateway in their HTTPRoutes:
    
    ```yaml
    # In any service chart values.yaml
    exposure:
      method: "gateway"
    gateway:
      gatewayRef:
        name: "{{ gateway_api.gateway.name }}"
        namespace: "{{ gateway_api.gateway.namespace }}"
    ```
    
    ## Supported Applications
    - ArgoCD: https://argocd.{{ kubeadm.base_domain }}
    - Grafana: https://grafana.{{ kubeadm.base_domain }}  
    - Dashboard: https://dashboard.{{ kubeadm.base_domain }}
    - Registry: https://registry.{{ kubeadm.base_domain }}
    
    ## Gateway Status Commands
    ```bash
    # Check Gateway status
    kubectl get gateway {{ gateway_api.gateway.name }} -n {{ gateway_api.gateway.namespace }}
    
    # Check Gateway Class
    kubectl get gatewayclass {{ gateway_api.gateway.className }}
    
    # List all HTTPRoutes using this Gateway
    kubectl get httproute -A
    
    # Check Cilium Gateway API status
    cilium status | grep -i gateway
    ```
    
    ## Troubleshooting
    ```bash
    # Check Cilium logs for Gateway API
    kubectl logs -n kube-system daemonset/cilium | grep -i gateway
    
    # Verify Gateway API CRDs
    kubectl api-resources | grep gateway
    
    # Check Gateway readiness
    kubectl describe gateway {{ gateway_api.gateway.name }} -n {{ gateway_api.gateway.namespace }}
    ```
    
    Generated by Ansible on {{ ansible_date_time.iso8601 }}