{
  "dashboard": {
    "id": null,
    "title": "eBPF + AI Security Monitoring Dashboard",
    "tags": ["ebpf", "ai", "security", "threats"],
    "timezone": "browser",
    "refresh": "5s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "🚨 Threats Detected (Real-time)",
        "type": "stat",
        "targets": [
          {
            "expr": "ml_detector_threats_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 50}
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "📊 ML Detector Requests Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(ml_detector_requests_total[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "🌐 eBPF Network Traffic (Bytes/sec)",
        "type": "stat",
        "targets": [
          {
            "expr": "ebpf_bytes_per_second",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "Bps"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "⚡ eBPF Events Processed",
        "type": "stat",
        "targets": [
          {
            "expr": "ebpf_events_processed_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "🔍 Threat Detection Timeline",
        "type": "timeseries",
        "targets": [
          {
            "expr": "increase(ml_detector_threats_total[1m])",
            "refId": "A",
            "legendFormat": "{{threat_type}} ({{confidence_level}})"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": {"mode": "none"},
              "axisPlacement": "auto",
              "axisLabel": "",
              "scaleDistribution": {"type": "linear"},
              "hideFrom": {"legend": false, "tooltip": false, "vis": false},
              "thresholdsStyle": {"mode": "off"}
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "📈 ML Processing Performance",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(ml_detector_processing_seconds_sum[5m]) / rate(ml_detector_processing_seconds_count[5m])",
            "refId": "A",
            "legendFormat": "Avg Processing Time"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "🌐 Network Traffic by Protocol",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(ebpf_bytes_processed_total[5m])",
            "refId": "A",
            "legendFormat": "{{protocol}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "Bps"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 8,
        "title": "🎯 ML Anomaly Scores",
        "type": "timeseries",
        "targets": [
          {
            "expr": "ml_detector_anomaly_score",
            "refId": "A",
            "legendFormat": "Worker {{pid}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "min": 0,
            "max": 1,
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 9,
        "title": "🔄 Communication Health",
        "type": "stat",
        "targets": [
          {
            "expr": "ebpf_ml_post_failures_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24}
      },
      {
        "id": 10,
        "title": "📊 Total Data Processed",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(ebpf_bytes_processed_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "bytes"
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24}
      }
    ]
  }
}